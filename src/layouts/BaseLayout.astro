---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileMapBar from "../components/MobileMapBar.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  language?: string;
  ogLocale?: string;
  alternateLanguages?: Array<{
    lang: string;
    href: string;
  }>;
  ogType?: "website" | "article";
  /** 社群分享標題，未提供時使用 title */
  ogTitle?: string;
  /** 社群分享描述，未提供時使用 description */
  ogDescription?: string;
  noindex?: boolean;
  showMobileMapBar?: boolean;
  mapUrl?: string;
  directionsUrl?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = site.defaultOgImage,
  imageAlt = description,
  language = "zh-Hant-TW",
  ogLocale = "zh_TW",
  alternateLanguages = [],
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  noindex = false,
  showMobileMapBar = true,
  mapUrl,
  directionsUrl,
} = Astro.props;

const uiLang = language === "en" ? "en" : "zh";

const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  alternateName: "Wanggaoliao Night View Guide",
  url: site.url,
  inLanguage: language,
};
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081426" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLanguages.map(({ lang, href }) => (
        <link rel="alternate" hreflang={lang} href={new URL(href, Astro.site)} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- PWA / 加入主畫面 -->
    <meta name="application-name" content={site.brand} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={site.brand} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-HXM22WWPKP");
    </script>

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="head" />
  </head>

  <body class="bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2"
    >
      跳至主要內容
    </a>
    <Header lang={uiLang} mapUrl={mapUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={uiLang} />
    {showMobileMapBar && <MobileMapBar mapUrl={mapUrl} directionsUrl={directionsUrl} />}

    <script is:inline>
      // PWA：註冊 Service Worker（僅在支援的瀏覽器與非 file:// 環境下執行）
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {
            /* 註冊失敗不影響網站功能 */
          });
        });
      }
    </script>
  </body>
</html>
