---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MapActions from "../components/MapActions.astro";
import SourcesSection from "../components/SourcesSection.astro";
import { site } from "../data/site";
import { place } from "../data/place";

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  canonical: string;
  category: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  heroCredit?: string;
  mapQuery?: string;
  officialSource?: string;
  noindex?: boolean;
  related?: RelatedLink[];
  /**
   * 額外的 JSON-LD 結構化資料：例如 VideoObject、FAQPage、HowTo 等。
   * 會以 `<script type="application/ld+json">` 注入 `<head>`。
   */
  extraSchema?: object[];
}

const {
  title,
  seoTitle,
  description,
  canonical,
  category,
  heroImage,
  heroAlt,
  heroCredit,
  mapQuery,
  officialSource,
  noindex = false,
  related = [],
  extraSchema = [],
} = Astro.props;

/**
 * 預設的 hreflang 對照：所有中文指南頁都會指向繁體中文本身與英文站。
 * 若該頁需要精確對應到一個英文版本（目前僅首頁），仍可在呼叫端覆寫。
 */
const defaultAlternateLanguages = [
  { lang: "zh-Hant-TW", href: canonical },
  { lang: "x-default", href: canonical },
];

const canonicalUrl = new URL(canonical, Astro.site).href;
const mapUrl = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}` : undefined;
const directionsUrl = mapQuery ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}` : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: "zh-Hant-TW",
  mainEntityOfPage: canonicalUrl,
  author: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
  about: mapQuery ? {
    "@type": "TouristAttraction",
    name: title,
    hasMap: mapUrl,
    sameAs: officialSource ? [officialSource] : undefined,
  } : {
    "@type": "TouristAttraction",
    "@id": `${site.url}/#attraction`,
    name: place.name,
    alternateName: [place.englishName, place.shortName],
    url: site.url,
    geo: {
      "@type": "GeoCoordinates",
      latitude: place.latitude,
      longitude: place.longitude,
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: place.address.streetAddress,
      addressLocality: place.address.district,
      addressRegion: place.address.city,
      postalCode: place.address.postalCode,
      addressCountry: place.address.country,
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: site.url + "/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={description}
  canonical={canonical}
  ogType="article"
  noindex={noindex}
  alternateLanguages={defaultAlternateLanguages}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {
      extraSchema.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 py-10 pb-28 md:pb-16">
    <Breadcrumbs crumbs={[{ label: "首頁", href: "/" }, { label: title }]} />

    <header class="mt-6">
      <p class="text-sm font-semibold text-amber-600">{category}</p>
      <h1 class="mt-2 text-3xl font-bold leading-snug text-ink md:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{description}</p>
    </header>

    {mapUrl && directionsUrl ? (
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-line bg-white px-5 py-3 text-center font-semibold text-ink">查看此景點地圖</a>
        <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-amber-cta px-5 py-3 text-center font-bold text-night">導航至此景點</a>
      </div>
    ) : <MapActions class="mt-6" />}

    {
      heroImage && (
        <figure class="mt-8">
          <Image
            src={heroImage}
            alt={heroAlt ?? title}
            widths={[480, 768, 1200]}
            sizes="(max-width: 768px) 100vw, 768px"
            class="w-full rounded-2xl border border-line"
            loading="eager"
            fetchpriority="high"
          />
          {heroCredit && (
            <figcaption class="mt-2 text-xs text-ink-soft">{heroCredit}</figcaption>
          )}
        </figure>
      )
    }

    <div
      class="prose prose-slate mt-8 max-w-none prose-headings:font-bold prose-headings:text-ink prose-a:text-amber-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-2xl"
    >
      <slot />
    </div>

    {
      related.length > 0 && (
        <nav aria-label="相關頁面" class="mt-10 rounded-2xl border border-line bg-white p-6">
          <h2 class="text-lg font-bold text-ink">相關攻略</h2>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {related.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-semibold text-amber-600 transition hover:underline"
                >
                  {link.label} →
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="mt-10 rounded-2xl bg-night p-6 text-center">
      <p class="font-bold text-white">準備出發了嗎？</p>
      {mapUrl && directionsUrl ? <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded-xl bg-amber-cta px-5 py-3 font-bold text-night">導航至{title}</a> : <MapActions class="mt-4 justify-center" />}
    </div>

    <SourcesSection class="mt-8" />
  </article>
</BaseLayout>
