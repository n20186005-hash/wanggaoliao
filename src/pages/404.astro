---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapActions from "../components/MapActions.astro";
---

<BaseLayout
  title="找不到頁面｜望高寮夜景公園旅遊指南"
  description="您要找的頁面不存在，回到首頁繼續規劃您的望高寮之旅。"
  noindex={true}
  showMobileMapBar={false}
>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center">
    <p class="text-6xl font-bold text-amber-cta">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink md:text-3xl">這條路不通往望高寮</h1>
    <p class="mt-3 text-ink-soft">您要找的頁面不存在或已移動。試試以下入口：</p>

    <nav class="mt-8 flex flex-wrap justify-center gap-3" aria-label="常用頁面">
      <a href="/" class="rounded-xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-amber-cta">回到首頁</a>
      <a href="/night-view/" class="rounded-xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-amber-cta">夜景攻略</a>
      <a href="/parking/" class="rounded-xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-amber-cta">停車攻略</a>
      <a href="/faq/" class="rounded-xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-amber-cta">常見問題</a>
    </nav>

    <div class="mt-10">
      <MapActions />
    </div>
  </div>
</BaseLayout>
