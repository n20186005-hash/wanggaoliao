---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { place } from "../../data/place";
import { site } from "../../data/site";
import { rating, reviewsSourceNote } from "../../data/rating";
import heroImage from "../../assets/hero/wanggaoliao-skyline-night-1.jpg";
import { englishGuides } from "../../data/englishGuides";
const attractionLinks = Object.entries(englishGuides).filter(([slug]) => slug.startsWith("attractions/"));
const topicLinks = Object.entries(englishGuides).filter(([slug]) => !slug.startsWith("attractions/"));
---

<BaseLayout
  title="Wanggaoliao Night View Park Taichung: Hours, Parking, Transport & Live Camera"
  description="Free hilltop park in Taichung for sunset and Taichung skyline night views. Hours 24/7, free parking, 20-30 min by car from downtown, live 4K camera, Rainbow Village nearby."
  canonical="/en/"
  language="en"
  ogLocale="en_US"
  ogTitle="Wanggaoliao Night View Park (Taichung): Free Hilltop Sunset & Night Views"
  ogDescription="Free 24-hour hilltop park in Taichung with sunset views over the coast and night views of the city skyline. Parking, transport, sunset and night view times, plus a live 4K camera and nearby Rainbow Village."
  imageAlt="Taichung night skyline viewed from Wanggaoliao Night View Park"
  alternateLanguages={[
    { lang: "en", href: "/en/" },
    { lang: "zh-Hant-TW", href: "/" },
    { lang: "x-default", href: "/" },
  ]}
>
  <Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    name: place.name,
    alternateName: [place.englishName, place.shortNameEn, "望高寮夜景公園"],
    url: `${site.url}/en/`,
    image: [`${site.url}${site.defaultOgImage}`],
    description: "Free 24-hour hilltop park in Taichung, Taiwan, famous for panoramic night views of the city skyline and sunset views toward Taichung Port.",
    isAccessibleForFree: true,
    publicAccess: true,
    inLanguage: ["en", "zh-Hant-TW"],
    geo: {
      "@type": "GeoCoordinates",
      latitude: place.latitude,
      longitude: place.longitude,
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: place.address.streetAddress,
      addressLocality: place.address.district,
      addressRegion: place.address.city,
      postalCode: place.address.postalCode,
      addressCountry: place.address.country,
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday",
        ],
        opens: "00:00",
        closes: "23:59",
      },
    ],
    touristType: ["Couples", "Families", "Photographers"],
    hasMap: place.googleMapsUrl,
    sameAs: [place.mapsShareUrl, place.govtTourismUrl],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${site.url}/en/`,
    name: "Wanggaoliao Night View Park - Taichung Visitor Guide",
    inLanguage: "en",
    isPartOf: {
      "@type": "WebSite",
      name: site.name,
      url: site.url,
    },
  })} />
</Fragment>

<div class="mx-auto max-w-3xl px-4 py-10 pb-28 md:pb-16" lang="en">
    <h1 class="text-3xl font-bold text-ink md:text-4xl">
      Wanggaoliao Night View Park（Taichung）
    </h1>
    <p class="mt-3 text-lg leading-relaxed text-ink-soft">
      A free hilltop park on the Dadu Plateau in Taichung, Taiwan, famous for its
      panoramic night view of the city lights, and sunsets over the coastline.
    </p>

    <p class="mt-5 leading-relaxed text-ink">
      <strong>Wanggaoliao Night View Park</strong> lies on the Dadu Plateau in
      Nantun District, <strong>Taichung City, Taiwan</strong>. The elevated site offers
      a view across the city lights after dark. It works particularly well as the
      final stop of a day exploring nearby landmarks such as
      <a href="/en/attractions/rainbow-village/">Rainbow Village</a> and
      <a href="/en/attractions/zhuifen-station/">Zhuifen Station</a>.
    </p>

    <p class="mt-3 text-sm text-ink-soft">
      Wanggaoliao Night View Park › Taichung City › Nantun District › Taiwan ·
      Address: {place.address.full} · Plus Code: {place.plusCode}
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        href={place.directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl bg-amber-cta px-5 py-3 text-center font-bold text-night"
      >
        Navigate with Google Maps
      </a>
      <a
        href={place.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border border-line bg-white px-5 py-3 text-center font-semibold text-ink"
      >
        View on Google Maps
      </a>
    </div>

    <figure class="mt-8">
      <Image
        src={heroImage}
        alt="Night skyline of Taichung seen from Wanggaoliao"
        widths={[480, 768, 1200]}
        sizes="(max-width: 768px) 100vw, 768px"
        class="w-full rounded-2xl border border-line"
      />
      <figcaption class="mt-2 text-xs text-ink-soft">
        Taichung city lights from Wanggaoliao. Photo: 敖摩 龔, Wikimedia Commons, CC BY-SA 2.0
      </figcaption>
    </figure>

    <div class="prose prose-slate mt-8 max-w-none prose-headings:text-ink prose-a:text-amber-600">
      <h2>Quick facts</h2>
      <ul>
        <li><strong>Admission:</strong> Free, open 24 hours, no ticket needed.</li>
        <li><strong>Location:</strong> No. 601, Zhongtai Road, Chunshe Village, Nantun District, Taichung City, Taiwan.</li>
        <li><strong>Best time:</strong> arrive before sunset; the "blue hour" 20–40 minutes after sunset is the highlight.</li>
        <li><strong>What you see:</strong> Taichung city skyline, Taichung Port, and the Changhua plain.</li>
        <li>
          <strong>Google Maps rating:</strong> {rating.value} / 5 from {rating.reviewCountLabel}{" "}
          user reviews (synced {rating.syncedAtLabel}).
        </li>
      </ul>

      <h2>Two viewpoints, two directions</h2>
      <p>
        There are two separate spots on the hill. The <strong>Night View Park</strong>
        faces the Taichung city skyline — go there after sunset for the sea of city
        lights. The <strong>Lookout Platform</strong> faces southwest toward the coast —
        go there <em>before</em> sunset. If you want both, watch the sunset at the
        platform first, then move to the park for blue hour (they are only a few
        minutes apart by car).
      </p>

      <h2>Getting there</h2>
      <ul>
        <li>
          <strong>By car or scooter (recommended):</strong> about 20–30 minutes from
          central Taichung. Search "Wanggaoliao Night View Park" in Google Maps. Free
          parking near the entrance; arrive 40–60 minutes before sunset on weekends.
        </li>
        <li>
          <strong>By taxi / ride-hailing:</strong> easy to get a ride up; for the way
          back at night, agree on a pickup time with your driver or expect a longer
          wait.
        </li>
        <li>
          <strong>By bus:</strong> possible but limited — buses stop a walk away from
          the park and evening service is sparse. Check return times before you go.
        </li>
      </ul>

      <h2>Good to know</h2>
      <ul>
        <li>It is windy on the plateau — bring a jacket even in summer.</li>
        <li>No restaurants or convenience stores on site; eat before you go up.</li>
        <li>Paths and steps are dimly lit at night; use your phone light.</li>
        <li>
          Nearby: <a href="/en/attractions/rainbow-village/">Rainbow Village</a> (10–15 min by car) makes a great afternoon stop
          before sunset here.
        </li>
      </ul>

      <p>
        For live conditions, traffic, and reviews, check
        <a href={place.googleMapsUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>.
        A live 4K webcam is available on the
        <a href={place.liveCameraUrl} target="_blank" rel="noopener noreferrer">Taichung Tourism website</a>.
      </p>
    </div>

    <section class="mt-12" id="english-guides">
      <p class="text-sm font-bold uppercase tracking-wide text-amber-600">Plan your trip</p>
      <h2 class="mt-2 text-2xl font-bold text-ink">Explore the complete English visitor guides</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">Find detailed advice about road access, parking, public transport, seasonal conditions, family trips and photography. Each topic opens a dedicated English-language page.</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {topicLinks.map(([slug, content]) => <a href={`/en/${slug}/`} class="rounded-xl border border-line bg-white p-4 transition hover:border-amber-cta"><h3 class="font-bold text-ink">{content.title}</h3><p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">{content.intro}</p><span class="mt-3 inline-block text-sm font-semibold text-amber-600">Read the guide →</span></a>)}
      </div>
    </section>

    <section class="mt-12" id="nearby-english">
      <p class="text-sm font-bold uppercase tracking-wide text-amber-600">Around the Dadu Plateau</p>
      <h2 class="mt-2 text-2xl font-bold text-ink">16 nearby attractions with English guides</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">From historic railway stations and temples to wooded trails, neighbourhoods and modern architecture, choose a daylight stop before the evening skyline. Every location has its own map search and practical visitor information.</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {attractionLinks.map(([slug, content]) => <a href={`/en/${slug}/`} class="rounded-xl border border-line bg-white p-4 transition hover:border-amber-cta"><h3 class="font-bold text-ink">{content.title}</h3><p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">{content.intro}</p><span class="mt-3 inline-block text-sm font-semibold text-amber-600">Explore this place →</span></a>)}
      </div>
    </section>

    <section id="sources" class="mt-10 rounded-2xl border border-line bg-white p-6" lang="en">
      <h2 class="text-lg font-bold text-ink">Sources, ratings &amp; image credits</h2>
      <ul class="mt-3 space-y-3 text-sm leading-relaxed text-ink-soft">
        <li>
          <strong class="text-ink">Place data:</strong> name, address, Plus Code and
          coordinates are taken from the Google Maps place page for Wanggaoliao Night
          View Park.
          <a
            href={place.mapsShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-amber-600 hover:underline">View on Google Maps ↗</a
          >
        </li>
        <li>
          <strong class="text-ink">Rating · synced {rating.syncedAtLabel}:</strong>
          the {rating.value} / 5 score and {rating.reviewCountLabel} review count are
          synced from Google Maps user reviews; copyright belongs to the original
          reviewers and Google Maps.
          <a
            href={place.mapsShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-amber-600 hover:underline"
            >See all reviews on Google Maps ↗</a
          >
        </li>
        <li>
          <strong class="text-ink">Official information:</strong> attraction description
          and the 4K live camera are provided by the Taichung City Government Tourism
          Bureau.
          <a
            href={place.govtTourismUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-amber-600 hover:underline">Taichung Tourism ↗</a
          >
        </li>
        <li>
          <strong class="text-ink">Images:</strong> all image property and copyright on
          this website belong to the original photographers.
        <a href="/en/about/" class="font-semibold text-amber-600 hover:underline"
            >Image credits ✓</a
          >
        </li>
      </ul>
      <p class="mt-4 flex flex-col gap-3 sm:flex-row">
        <a
          href={place.mapsShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-amber-cta px-5 py-3 text-center font-bold text-night transition hover:brightness-105"
        >
          See all reviews on Google Maps
        </a>
        <a
          href="/"
          class="rounded-xl border border-line px-5 py-3 text-center font-semibold text-ink transition hover:border-amber-cta"
        >
          中文完整指南
        </a>
      </p>
      <p class="mt-3 text-xs text-ink-soft">{reviewsSourceNote}</p>
    </section>
  </div>
</BaseLayout>
