---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import officialNight from "../assets/official/wanggaoliao-night.jpg";
import officialWalkway from "../assets/official/wanggaoliao-walkway.jpg";
import officialLighting from "../assets/official/wanggaoliao-lighting.jpg";
import officialPanorama from "../assets/official/wanggaoliao-panorama.jpg";
import parkPlaza from "../assets/park/park-plaza.jpg";
import lookoutSouthwest from "../assets/viewpoints/lookout-southwest.jpg";

interface Props {
  variant: "accessibility" | "facilities" | "viewpoints";
}

interface PhotoItem {
  image: ImageMetadata;
  label: string;
  alt: string;
  caption: string;
  credit: string;
  dark?: boolean;
}

const { variant } = Astro.props;

const officialCredit = "圖片：臺中觀光旅遊網（政府資料開放授權條款第 1 版）";

const groups: Record<Props["variant"], PhotoItem[]> = {
  accessibility: [
    {
      image: officialWalkway,
      label: "主步道",
      alt: "望高寮設有護欄的平整木棧步道",
      caption: "主要步道有連續鋪面與護欄，輪椅與推車應以這類動線為主。",
      credit: officialCredit,
    },
    {
      image: parkPlaza,
      label: "草坡與階梯",
      alt: "望高寮夜景公園草坡、階梯與廣場的高差",
      caption: "園區仍有草坡、階梯與高差；較好的視野不代表適合輪椅或推車通行。",
      credit: "攝影：LowensteinYang（Wikimedia Commons，CC BY-SA 4.0）",
    },
  ],
  facilities: [
    {
      image: officialWalkway,
      label: "步道與護欄",
      alt: "望高寮日間木棧步道與護欄",
      caption: "木棧步道串連觀景區，白天較容易辨認園區高差。",
      credit: officialCredit,
    },
    {
      image: officialLighting,
      label: "夜間引導照明",
      alt: "望高寮夜間木棧步道與低層照明",
      caption: "燈光以引導動線與保留夜景為主，不等於每一處都明亮。",
      credit: officialCredit,
      dark: true,
    },
    {
      image: officialPanorama,
      label: "草坡與廣場",
      alt: "望高寮夜景公園草坡、廣場與路燈全景",
      caption: "草坡、階梯座席與廣場適合停留，但夜間要看清腳下。",
      credit: officialCredit,
      dark: true,
    },
  ],
  viewpoints: [
    {
      image: officialNight,
      label: "夜景公園｜向東",
      alt: "由望高寮夜景公園眺望臺中市區燈海",
      caption: "城市高樓與密集燈海是夜景公園的主景，適合藍調至入夜。",
      credit: officialCredit,
      dark: true,
    },
    {
      image: lookoutSouthwest,
      label: "觀景平台｜向西南",
      alt: "由望高寮觀景平台眺望彰化平原與海線方向",
      caption: "海線、河谷與彰化平原是觀景平台的主景，適合日落之前。",
      credit: "攝影：Kai3952（Wikimedia Commons，CC BY-SA 4.0）",
    },
  ],
};

const photos = groups[variant];
---

<div class:list={["not-prose my-8 grid gap-4", photos.length === 3 ? "md:grid-cols-3" : "sm:grid-cols-2"]}>
  {
    photos.map((photo) => (
      <figure class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">
        <div class="relative">
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[480, 768]}
            sizes={photos.length === 3 ? "(max-width: 768px) 100vw, 256px" : "(max-width: 640px) 100vw, 384px"}
            class="h-48 w-full object-cover"
            loading="lazy"
          />
          <span
            class:list={[
              "absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-bold shadow-sm",
              photo.dark ? "bg-white text-night" : "bg-night text-amber-cta",
            ]}
          >
            {photo.label}
          </span>
        </div>
        <figcaption class="p-4">
          <p class="text-sm leading-relaxed text-ink">{photo.caption}</p>
          <p class="mt-2 text-xs leading-relaxed text-ink-soft">{photo.credit}</p>
        </figcaption>
      </figure>
    ))
  }
</div>
