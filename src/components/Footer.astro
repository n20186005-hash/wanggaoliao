---
import { footerNav, footerNavEn } from "../data/navigation";
import { site } from "../data/site";

interface Props {
  lang?: "zh" | "en";
}

const { lang = "zh" } = Astro.props;
const groups = lang === "en" ? footerNavEn : footerNav;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-700 bg-night pb-24 text-slate-300 md:pb-0">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      {
        groups.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="mb-3 text-sm font-bold text-white">{group.title}</h2>
            <ul class="space-y-2">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="text-sm transition hover:text-amber-cta">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-5 border-t border-slate-700 pt-6 text-sm leading-relaxed text-slate-400 md:flex-row md:items-start md:justify-between">
      <div>
        <p>© {year} {lang === "en" ? "Wanggaoliao" : site.brand} · {lang === "en" ? "All rights reserved" : "版權所有"}</p>
        <p class="mt-2 max-w-xl">
          {lang === "en"
            ? "This website is an independent travel information project. We are not affiliated with any government agency or official organization."
            : "本網站是一個獨立的旅遊資訊項目。我們與任何政府機構或官方組織均無關聯。"}
        </p>
      </div>
      <nav aria-label={lang === "en" ? "Legal policies" : "網站政策"} class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end md:text-right">
        <a class="hover:text-amber-cta" href={lang === "en" ? "/en/privacy-policy/" : "/privacy-policy/"}>{lang === "en" ? "Privacy Policy" : "隱私政策"}</a>
        <a class="hover:text-amber-cta" href={lang === "en" ? "/en/terms-of-service/" : "/terms-of-service/"}>{lang === "en" ? "Terms of Service" : "服務條款"}</a>
        <a class="hover:text-amber-cta" href={lang === "en" ? "/en/cookie-settings/" : "/cookie-settings/"}>{lang === "en" ? "Cookie Settings" : "Cookie 設定"}</a>
      </nav>
    </div>
  </div>
</footer>
