---
import { place } from "../data/place";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-slate-700 bg-night/95 p-3 backdrop-blur md:hidden"
>
  <a
    href={place.googleMapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 rounded-xl border border-slate-500 px-4 py-3 text-center text-sm font-semibold text-white"
  >
    查看地圖
  </a>
  <a
    href={place.directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 rounded-xl bg-amber-cta px-4 py-3 text-center text-sm font-bold text-night"
  >
    開始導航
  </a>
</div>
