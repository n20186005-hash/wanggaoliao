---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  /** light：用於深色背景（Hero） */
  tone?: "default" | "light";
}

const { crumbs, tone = "default" } = Astro.props;

const isLight = tone === "light";
const navClass = isLight ? "text-sm text-slate-300" : "text-sm text-ink-soft";
const linkClass = isLight
  ? "transition hover:text-amber-cta"
  : "transition hover:text-amber-600";
const currentClass = isLight ? "text-white" : "text-ink";
---

<nav aria-label="麵包屑" class={navClass}>
  <ol class="flex flex-wrap items-center gap-1">
    {
      crumbs.map((crumb, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && <span aria-hidden="true">›</span>}
          {crumb.href ? (
            <a href={crumb.href} class={linkClass}>
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class={currentClass}>
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
