---
interface Props {
  manager: string;
  note: string;
  sourceUrl: string;
}

const { manager, note, sourceUrl } = Astro.props;
---

<aside class="not-prose my-6 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 shadow-sm sm:p-6" aria-label="景點管理主體">
  <p class="text-xs font-bold tracking-wider text-amber-800">景點管理與維護</p>
  <h3 class="mt-2 text-lg font-bold leading-snug text-ink">{manager}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{note}</p>
  <a class="mt-4 inline-flex text-sm font-semibold text-amber-700 hover:underline" href={sourceUrl} target="_blank" rel="noopener noreferrer">查看管理資料來源 ↗</a>
</aside>
