---
const routes = [
  {
    number: "99延",
    endpoints: "精武車站 ↔ 臺中區監理所",
    bestFor: "臺中市區、捷運大慶站、高鐵臺中站出發",
    stops: ["臺中公園", "捷運大慶站", "高鐵臺中站", "彩虹眷村", "望高寮"],
    href: "https://citybus-free.taichung.gov.tw/driving-map?route=991",
  },
  {
    number: "30延",
    endpoints: "第一廣場／干城站 ↔ 臺中區監理所",
    bestFor: "臺中車站周邊、南屯與嶺東方向",
    stops: ["第一廣場", "南屯", "嶺東科技大學", "望高寮"],
    href: "https://citybus-free.taichung.gov.tw/driving-map?route=3010",
  },
  {
    number: "323",
    endpoints: "彩虹眷村 ↔ 新建國市場",
    bestFor: "彩虹眷村、烏日與南區方向轉乘",
    stops: ["新建國市場", "烏日／嶺東周邊", "望高寮", "彩虹眷村"],
    href: "https://citybus-free.taichung.gov.tw/driving-map?route=323",
  },
  {
    number: "355",
    endpoints: "仁友停車場 ↔ 西苑高中",
    bestFor: "西屯、福科路與東海周邊",
    stops: ["西苑高中", "福科路", "臺中區監理所", "望高寮"],
    href: "https://citybus-free.taichung.gov.tw/driving-map?route=355",
  },
];
---

<div class="not-prose my-8">
  <div class="rounded-2xl bg-night p-5 text-white sm:p-6">
    <p class="text-xs font-bold tracking-[0.16em] text-amber-cta">搭車流程</p>
    <ol class="mt-4 grid gap-3 sm:grid-cols-4">
      {
        ["選擇直達路線", "去回程一起查", "「望高寮」站下車", "沿入口指示進園"].map(
          (step, index) => (
            <li class="flex items-center gap-3 rounded-xl bg-white/10 p-3 text-sm font-semibold">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-cta text-xs font-bold text-night">
                {index + 1}
              </span>
              {step}
            </li>
          ),
        )
      }
    </ol>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    {
      routes.map((route) => (
        <article class="flex h-full flex-col rounded-2xl border border-line bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-2xl font-black text-ink">{route.number}</p>
              <p class="mt-1 text-sm font-semibold text-ink">{route.endpoints}</p>
            </div>
            <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-ink-soft">
              直達望高寮
            </span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">{route.bestFor}</p>
          <div class="mt-4 flex flex-wrap gap-2" aria-label={`${route.number} 部分停靠站`}>
            {
              route.stops.map((stop) => (
                <span class="rounded-lg bg-paper px-2.5 py-1.5 text-xs font-medium text-ink">
                  {stop}
                </span>
              ))
            }
          </div>
          <a
            href={route.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex font-semibold text-amber-600 hover:underline"
          >
            查官方即時到站 →
          </a>
        </article>
      ))
    }
  </div>

  <div class="mt-4 rounded-2xl border border-amber-cta/50 bg-amber-cta/10 p-5">
    <p class="font-bold text-ink">不要只看去程</p>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
      四條路線的班距、行駛方向與末班時間不同。先在官方頁面切換去回方向，確認看完夜景後仍有可搭班次，再決定停留時間。
    </p>
    <a
      href="https://citybus.taichung.gov.tw/"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex text-sm font-semibold text-amber-600 hover:underline"
    >
      開啟臺中市公車即時動態 →
    </a>
  </div>
</div>
