---
/**
 * 望高寮四季游覽策略（中央氣象署常年平均＋臺中市觀旅局說明整理）
 * - 每頁內容不為「研究」或「学術考證」，僅作為非營利出發出預参考
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const seasons = [
  {
    label: "春",
    months: "3–5 月",
    weather: "雲系與鋒面影響，雲量多、能見度變動大",
    highlights: ["藍調夜景", "雨後放晴", "黃花風鈴木"],
    caution: "濃霧時段能見度低，請勿勉強上山",
    rating: "★★",
  },
  {
    label: "夏",
    months: "6–8 月",
    weather: "午後雷陣雨為主；夜間對流消散後轉晴",
    highlights: ["晚落日", "颱風過後放晴", "高空光害"],
    caution: "雷雨胞與蛇蟲，建議攜防蚊液",
    rating: "★★",
  },
  {
    label: "秋",
    months: "9–11 月",
    weather: "東北季風初期多雲，中期後轉為穩定乾爽",
    highlights: ["能見度最佳", "夕陽＋藍調＋夜景", "芒草與過境猛禽"],
    caution: "仍有颱風殘餘雲系，需看氣象署",
    rating: "★★★★★",
  },
  {
    label: "冬",
    months: "12–2 月",
    weather: "冷氣團影響；冷氣團過後晴朗清晨有機會見雲海",
    highlights: ["冷暖色溫反差", "夜景透明度高", "稀見雲海"],
    caution: "低溫與強風，長者需評估體力",
    rating: "★★★",
  },
];
---

<section
  class:list={["not-prose mt-6", className]}
  aria-labelledby="seasonal-heading"
>
  <div class="flex flex-wrap items-end justify-between gap-2">
    <h3 id="seasonal-heading" class="text-lg font-bold text-ink md:text-xl">
      四季游覽策略
    </h3>
    <p class="text-xs text-ink-soft">基於中央氣象署常年平均與本地觀察整理</p>
  </div>
  <p class="mt-2 text-sm text-ink-soft">
    評分為<strong class="text-ink">「看夜景與夕陽的綜合適合度」</strong>，並非氣象實況；
    請同步參考<a href="/weather" class="font-semibold text-amber-600 hover:underline">即時天氣模組</a>、4K 即時影像與空氣品質。
  </p>

  <ol class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {seasons.map((season) => (
      <li class="rounded-2xl border border-line bg-white p-5">
        <div class="flex items-baseline justify-between">
          <p class="text-2xl font-bold text-ink">{season.label}</p>
          <p class="text-xs text-ink-soft">{season.months}</p>
        </div>
        <p class="mt-1 text-lg text-amber-600" aria-label={`綜合適合度 ${season.rating}`}>
          {season.rating}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink">{season.weather}</p>
        <div class="mt-3">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">亮點</p>
          <ul class="mt-1 space-y-1 text-sm text-ink">
            {season.highlights.map((h) => (
              <li>・{h}</li>
            ))}
          </ul>
        </div>
        <p class="mt-3 text-xs text-amber-600">注意：{season.caution}</p>
      </li>
    ))}
  </ol>

  <p class="mt-4 text-xs text-ink-soft">
    完整月份 × 氣象 × 適合度表請見<a href="/seasons/" class="font-semibold text-amber-600 hover:underline">四季游覽指南 →</a>
  </p>
</section>