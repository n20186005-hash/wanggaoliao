---
interface Props {
  title?: string;
}

const { title = "出發前提醒" } = Astro.props;
---

<aside class="not-prose my-6 rounded-2xl border border-amber-cta/60 bg-amber-cta/10 p-5">
  <p class="font-bold text-ink">{title}</p>
  <div class="mt-2 text-sm leading-relaxed text-ink">
    <slot>
      開放狀態、即時路況、訪客評論及導航路線，請以 Google 地圖顯示為準。
    </slot>
  </div>
</aside>
