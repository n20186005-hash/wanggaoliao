---
import { mainNav } from "../data/navigation";
import { place } from "../data/place";
import { site } from "../data/site";
---

<header class="sticky top-0 z-40 border-b border-line bg-night text-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex items-center gap-2 whitespace-nowrap" aria-label={`${site.brand}首頁`}>
      <img src="/favicon.svg" width="36" height="36" alt="" class="h-9 w-9 flex-none" />
      <span class="text-lg font-bold tracking-wide">{site.brand}</span>
      <span class="hidden text-xs font-semibold tracking-[0.2em] text-amber-cta sm:inline"
        >{site.brandEn}</span
      >
    </a>

    <nav aria-label="主選單" class="hidden items-center gap-6 md:flex">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-slate-200 transition hover:text-amber-cta"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={place.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl bg-amber-cta px-4 py-2 text-sm font-bold text-night transition hover:brightness-110"
      >
        在 Google 地圖開啟
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-600 [&::-webkit-details-marker]:hidden"
        aria-label="開啟選單"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        aria-label="行動版選單"
        class="absolute right-0 top-12 z-50 flex w-52 flex-col gap-1 rounded-2xl border border-slate-700 bg-night-soft p-3 shadow-xl"
      >
        {
          mainNav.map((item) => (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-slate-100 hover:bg-night"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={place.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 rounded-lg bg-amber-cta px-3 py-2 text-center text-sm font-bold text-night"
        >
          在 Google 地圖開啟
        </a>
      </nav>
    </details>
  </div>
</header>
